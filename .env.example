# ============================================================
#  B2AUTH — Environment Variables Template (SAFE TO COMMIT)
# ============================================================
#  Copy this file to .env and fill in your actual values.
#  The .env file is git-ignored and must never be committed.
#
#  How to use:
#  flutter run \
#    --dart-define=CASHFREE_CLIENT_ID=$CASHFREE_CLIENT_ID \
#    --dart-define=CASHFREE_CLIENT_SECRET=$CASHFREE_CLIENT_SECRET \
#    --dart-define=CASHFREE_PUBLIC_KEY=$CASHFREE_PUBLIC_KEY
# ============================================================

# Cashfree Credentials (get from https://merchant.cashfree.com/merchants/developer)
CASHFREE_CLIENT_ID=your_cashfree_client_id_here
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret_here
CASHFREE_PUBLIC_KEY=your_cashfree_public_key_here
